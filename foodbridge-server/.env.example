# Server Configuration
PROJECT_NAME="FoodBridge API"
VERSION="1.0.0"
DESCRIPTION="AI-Powered Surplus Food Prediction & Rescue Platform"
ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="sqlite:///./foodbridge.db"

# CORS Configuration (JSON-encoded list of allowed origins)
CORS_ORIGINS=["*"]

# Firebase Admin SDK Configuration
# Optional: Path to your Firebase service account JSON key file.
# If not provided or file is missing, the backend operates in development mock mode.
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID=""
